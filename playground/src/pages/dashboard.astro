---
import Layout from '../layouts/Layout.astro';
import { getSession } from 'astro-sessionkit/server';

const session = getSession();
---

<Layout>
    <div class="bg-white p-8 rounded-lg shadow-md">
        <h1 class="text-2xl font-bold mb-4">Dashboard</h1>
        <p class="mb-6">This page is protected by <code>globalProtect: true</code>.</p>
        
        <div class="bg-blue-50 border-l-4 border-blue-400 p-4">
            <h2 class="font-semibold">Current Session Data:</h2>
            <pre class="mt-2 text-sm">{JSON.stringify(session, null, 2)}</pre>
        </div>
    </div>
</Layout>
