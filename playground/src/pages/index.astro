---
import Layout from '../layouts/Layout.astro';
import { getSession } from 'astro-sessionkit/server';

const session = getSession();
---

<Layout>
	<div class="bg-white p-8 rounded-lg shadow-md">
		<h1 class="text-3xl font-bold mb-4">Welcome to Astro SessionKit</h1>
		<p class="text-gray-600 mb-6">
			This playground allows you to test the library's features in a real Astro environment.
		</p>
		
		<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
			<div class="border p-4 rounded-md">
				<h2 class="text-xl font-semibold mb-2">Session Status</h2>
				{session ? (
					<div class="bg-green-100 text-green-800 p-2 rounded">
						Logged in as <span class="font-bold">{session.email}</span>
					</div>
				) : (
					<div class="bg-yellow-100 text-yellow-800 p-2 rounded">
						Not logged in.
					</div>
				)}
			</div>
			
			<div class="border p-4 rounded-md">
				<h2 class="text-xl font-semibold mb-2">Protected Routes</h2>
				<ul class="list-disc ml-5 space-y-1">
					<li><a href="/dashboard" class="text-blue-600 hover:underline">Dashboard</a> (Requires session)</li>
					<li><a href="/admin" class="text-blue-600 hover:underline">Admin</a> (Requires 'admin' role)</li>
				</ul>
			</div>
		</div>
	</div>
</Layout>
